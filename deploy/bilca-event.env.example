# Production file: /opt/bilca-event/.env. Keep it outside Git and chmod 600.
PORT=8080
BILCA_ADMIN_API_TOKEN=replace-with-a-long-random-secret
ORACLE_DATASOURCE_URL=jdbc:oracle:thin:@database_medium?TNS_ADMIN=/opt/bilca-event/wallet
ORACLE_DATASOURCE_USERNAME=event_app
ORACLE_DATASOURCE_PASSWORD=replace-with-a-strong-password

# Envio dos materiais por e-mail (Gmail). Gere a senha de app em https://myaccount.google.com/apppasswords
GMAIL_SMTP_USERNAME=sua-conta@gmail.com
GMAIL_SMTP_APP_PASSWORD=replace-with-gmail-app-password
BILCA_MAIL_FROM=Bilca Systems <sua-conta@gmail.com>
